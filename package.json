{
  "name": "droid2ios-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop IDE and agent-assisted Android to iOS conversion studio",
  "main": "dist-electron/main.js",
  "author": "Droid2iOS Studio",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
"dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
"dist:mac": "npm run build && electron-builder --mac zip --publish never"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1",
    "@types/adm-zip": "^0.5.7"
  },
  "build": {
    "appId": "dev.droid2ios.studio",
    "productName": "Droid2iOS Studio",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "directories": {
      "output": "release"
    },
   "win": {
  "target": [
    "nsis",
    "portable"
  ]
},
"nsis": {
  "oneClick": false,
  "allowToChangeInstallationDirectory": true,
  "createDesktopShortcut": true,
  "createStartMenuShortcut": true,
  "artifactName": "Droid2iOS-Studio-Setup-${version}-${arch}.${ext}"
},
"portable": {
  "artifactName": "Droid2iOS-Studio-Portable-${version}-${arch}.${ext}"
},
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
