import type { AppSettings, ProviderConfig, ProviderName } from '../types';

export interface LlmMessage {
  role: 'system' | 'user' | 'assistant';
  content: string;
}

export interface ProviderCallOptions {
  structured?: boolean;
}

export interface ProviderResult {
  text: string;
  provider: ProviderName;
  model: string;
  trace: string[];
}

const AGENT_RESPONSE_SCHEMA: any = {
  type: 'object',
  properties: {
    message: { type: 'string' },
    toolRequests: {
      type: 'array',
      items: {
        type: 'object',
        properties: {
          type: { type: 'string', enum: ['read_file', 'search_text'] },
          path: { type: 'string' },
          query: { type: 'string' }
        },
        required: ['type'],
        additionalProperties: false
      }
    },
    actions: {
      type: 'array',
      items: {
        type: 'object',
        properties: {
          type: { type: 'string', enum: ['write_file', 'delete_file', 'run_command'] },
          path: { type: 'string' },
          content: { type: 'string' },
          reason: { type: 'string' },
          command: { type: 'string' },
          cwd: { type: 'string' }
        },
        required: ['type'],
        additionalProperties: false
      }
    },
    diagnostics: {
      type: 'array',
      items: { type: 'string' }
    }
  },
  required: ['message', 'toolRequests', 'actions', 'diagnostics'],
  additionalProperties: false
};

function sleep(ms: number) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

function errorText(error: unknown) {
  return error instanceof Error ? error.message : String(error);
}

function statusFromError(error: unknown): number | null {
  const match = errorText(error).match(/\b(4\d\d|5\d\d)\b/);
  return match ? Number(match[1]) : null;
}

function retryable(error: unknown) {
  const status = statusFromError(error);
  if (status && [429, 500, 502, 503, 504].includes(status)) return true;

  const text = errorText(error).toLowerCase();
  return [
    'timeout',
    'timed out',
    'econnreset',
    'econnrefused',
    'fetch failed',
    'network',
    'temporarily unavailable',
    'high demand',
    'unavailable'
  ].some(token => text.includes(token));
}

function configuredCandidates(settings: AppSettings): ProviderConfig[] {
  const saved = settings.providers?.length ? settings.providers : [settings.provider];
  const byName = new Map<ProviderName, ProviderConfig>();

  for (const item of saved) byName.set(item.provider, item);
  byName.set(settings.provider.provider, {
    ...(byName.get(settings.provider.provider) || {}),
    ...settings.provider
  } as ProviderConfig);

  const primary = byName.get(settings.provider.provider) || settings.provider;
  const ordered = [
    primary,
    ...(['gemini', 'openrouter', 'ollama'] as ProviderName[])
      .filter(name => name !== primary.provider)
      .map(name => byName.get(name))
      .filter(Boolean) as ProviderConfig[]
  ];

  return ordered.filter((config, index) => {
    if (index === 0) return true;
    return settings.autoFallbackAgent && config.enabled;
  });
}

function modelCandidates(config: ProviderConfig): string[] {
  const values = [config.model, ...(config.fallbackModels || [])]
    .map(v => String(v || '').trim())
    .filter(Boolean);
  return [...new Set(values)].slice(0, 8);
}

export async function callProvider(
  config: ProviderConfig,
  messages: LlmMessage[],
  options: ProviderCallOptions = {}
): Promise<string> {
  if (config.provider === 'gemini') return callGemini(config, messages, options);
  if (config.provider === 'ollama') return callOllama(config, messages, options);
  return callOpenRouter(config, messages, options);
}

export async function callProviderWithFallback(
  settings: AppSettings,
  messages: LlmMessage[],
  options: ProviderCallOptions = {}
): Promise<ProviderResult> {
  const trace: string[] = [];
  const providers = configuredCandidates(settings);

  if (!providers.length) {
    throw new Error('Nenhum provedor de IA está configurado.');
  }

  for (const config of providers) {
    const models = settings.autoFallbackAgent ? modelCandidates(config) : [config.model];

    for (const model of models) {
      const candidate: ProviderConfig = { ...config, model };
      const maxAttempts = 2;

      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
        try {
          const text = await callProvider(candidate, messages, options);
          trace.push(`OK ${candidate.provider}/${candidate.model} na tentativa ${attempt}`);
          return {
            text,
            provider: candidate.provider,
            model: candidate.model,
            trace
          };
        } catch (error) {
          const message = errorText(error).replace(/\s+/g, ' ').slice(0, 700);
          trace.push(`FALHOU ${candidate.provider}/${candidate.model} tentativa ${attempt}: ${message}`);

          if (!retryable(error) || attempt === maxAttempts) break;

          // Backoff curto para 429/5xx. O contexto permanece exatamente igual.
          await sleep(attempt === 1 ? 750 : 1500);
        }
      }

      if (!settings.autoFallbackAgent) break;
    }

    if (!settings.autoFallbackAgent) break;
  }

  throw new Error(
    'Todos os modelos/provedores habilitados falharam. O progresso foi preservado em checkpoint local.\n' +
    trace.join('\n')
  );
}

async function callOpenRouter(
  config: ProviderConfig,
  messages: LlmMessage[],
  options: ProviderCallOptions
) {
  if (!config.apiKey) {
    throw new Error('OpenRouter 401: informe a API key nas configurações.');
  }

  const endpoint = config.baseUrl || 'https://openrouter.ai/api/v1/chat/completions';
  const body: any = {
    model: config.model || 'openrouter/free',
    messages,
    temperature: 0
  };

  if (options.structured) {
    body.response_format = {
      type: 'json_schema',
      json_schema: {
        name: 'droid2ios_agent_response',
        strict: true,
        schema: AGENT_RESPONSE_SCHEMA
      }
    };
    body.plugins = [{ id: 'response-healing' }];
    body.provider = { require_parameters: true };
  }

  let res = await fetch(endpoint, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${config.apiKey}`,
      'HTTP-Referer': 'https://github.com/',
      'X-Title': 'Droid2iOS Studio'
    },
    body: JSON.stringify(body)
  });

  if (!res.ok && options.structured && [400, 404, 422].includes(res.status)) {
    const firstError = await res.text();
    const fallbackBody: any = {
      model: config.model || 'openrouter/free',
      messages,
      temperature: 0,
      response_format: { type: 'json_object' },
      plugins: [{ id: 'response-healing' }]
    };

    res = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${config.apiKey}`,
        'HTTP-Referer': 'https://github.com/',
        'X-Title': 'Droid2iOS Studio'
      },
      body: JSON.stringify(fallbackBody)
    });

    if (!res.ok) {
      const secondError = await res.text();
      throw new Error(
        `OpenRouter ${res.status}: ${secondError}\n` +
        `Falha anterior usando json_schema: ${firstError.slice(0, 1200)}`
      );
    }
  }

  if (!res.ok) {
    throw new Error(`OpenRouter ${res.status}: ${await res.text()}`);
  }

  const json: any = await res.json();
  const choice = json.choices?.[0];

  if (choice?.finish_reason === 'length') {
    throw new Error(
      'OpenRouter 413: resposta interrompida por limite de saída; continue em lote menor.'
    );
  }

  const content = choice?.message?.content;
  if (typeof content !== 'string' || !content.trim()) {
    throw new Error('OpenRouter 502: resposta vazia ou sem conteúdo textual.');
  }

  return content;
}

async function callGemini(
  config: ProviderConfig,
  messages: LlmMessage[],
  options: ProviderCallOptions
) {
  if (!config.apiKey) {
    throw new Error('Gemini 401: informe a API key nas configurações.');
  }

  const model = config.model || 'gemini-3.7-flash';
  const system = messages
    .filter(m => m.role === 'system')
    .map(m => m.content)
    .join('\n\n');

  const contents = messages
    .filter(m => m.role !== 'system')
    .map(m => ({
      role: m.role === 'assistant' ? 'model' : 'user',
      parts: [{ text: m.content }]
    }));

  const endpoint =
    config.baseUrl ||
    `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${encodeURIComponent(config.apiKey)}`;

  const generationConfig: any = { temperature: 0 };
  if (options.structured) generationConfig.responseMimeType = 'application/json';

  const res = await fetch(endpoint, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      systemInstruction: { parts: [{ text: system }] },
      contents,
      generationConfig
    })
  });

  if (!res.ok) {
    throw new Error(`Gemini ${res.status}: ${await res.text()}`);
  }

  const json: any = await res.json();
  const candidate = json.candidates?.[0];

  if (candidate?.finishReason === 'MAX_TOKENS') {
    throw new Error('Gemini 413: resposta interrompida por limite de saída; continue em lote menor.');
  }

  const content =
    candidate?.content?.parts?.map((p: any) => p.text || '').join('') || '';

  if (!content.trim()) {
    throw new Error('Gemini 502: resposta vazia.');
  }

  return content;
}

async function callOllama(
  config: ProviderConfig,
  messages: LlmMessage[],
  options: ProviderCallOptions
) {
  const base = (config.baseUrl || 'http://localhost:11434').replace(/\/$/, '');

  const body: any = {
    model: config.model || 'qwen3-coder:30b',
    messages,
    stream: false,
    options: { temperature: 0 }
  };

  if (options.structured) body.format = 'json';

  let res: Response;
  try {
    res = await fetch(`${base}/api/chat`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
  } catch (error) {
    throw new Error(`Ollama 503: ${errorText(error)}`);
  }

  if (!res.ok) {
    throw new Error(`Ollama ${res.status}: ${await res.text()}`);
  }

  const json: any = await res.json();

  if (json.done_reason === 'length') {
    throw new Error('Ollama 413: resposta interrompida por limite de saída; continue em lote menor.');
  }

  const content = json.message?.content || '';
  if (!String(content).trim()) {
    throw new Error('Ollama 502: resposta vazia.');
  }

  return content;
}
